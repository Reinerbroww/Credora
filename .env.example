# Neon PostgreSQL
# Pooled connection (Neon pooler) for the Next.js/serverless runtime
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# Direct (non-pooled) connection for migrations
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

# Auth.js (NextAuth)
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional email provider for magic-link / email sign-in
# AUTH_EMAIL_SERVER=""
# AUTH_EMAIL_FROM=""

# ML service (FastAPI + LightGBM)
# Leave ML_SERVICE_URL empty to fall back to the built-in heuristic model.
# ML_SERVICE_URL="http://127.0.0.1:8000"
# ML_SERVICE_API_KEY=""
# Monetary inputs are stored in IDR; the model is trained on USD-scale data.
# This is a demo calibration factor (not the real exchange rate): 4000 maps the
# Indonesian income range onto the model's training distribution.
# ML_IDR_PER_USD="4000"
# ML_SERVICE_TIMEOUT_MS="8000"

# Set to 1 to score seeded demo assessments with the ML service instead of the
# built-in heuristic (requires ML_SERVICE_URL to be reachable).
# SEED_RESCORE_ML="1"
